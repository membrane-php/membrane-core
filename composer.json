{
  "name": "membrane/membrane",
  "type": "library",
  "license": "MPL-2.0",
  "autoload": {
    "psr-4": {
      "Membrane\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Membrane\\Tests\\": "tests/",
      "Membrane\\Tests\\Fixtures\\": "tests/fixtures/"
    }
  },
  "require": {
    "php": "^8.4.0",
    "atto/codegen-tools": "^0.1.2",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0.2",
    "symfony/console": "^7.4.19 || ^8.1.7",
    "membrane/openapi-reader": "^3.1.1",
    "membrane/openapi-router": "0.5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.1.14",
    "phpstan/phpstan": "^2.2.14",
    "squizlabs/php_codesniffer": "^4.0.4",
    "guzzlehttp/psr7": "^3.1.0",
    "mikey179/vfsstream": "^v1.6.12"
  },
  "bin": [
    "bin/membrane"
  ]
}
